# Plantilla para scripts/.env.vercel (el real está gitignored).
# Copia este archivo a scripts/.env.vercel, rellena los valores reales y ejecuta:
#   bash scripts/vercel-push-env.sh production
#   bash scripts/vercel-push-env.sh preview
#
# Guárdalo con saltos de línea LF. El script tolera CRLF, pero LF es lo esperado.

# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasa RLS. Solo se usa en el webhook. Nunca lo prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Flespi ─────────────────────────────────────────────────
FLESPI_TOKEN=
FLESPI_WEBHOOK_SECRET=
# Id del calculator de trips. Opcional: sin él, no hay historial de viajes.
FLESPI_TRIPS_CALC_ID=

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
