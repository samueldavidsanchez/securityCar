# ─── Supabase ───────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used exclusively in webhook handlers to bypass RLS.
# NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Flespi ─────────────────────────────────────────────────
# Server-only token. Never prefix with NEXT_PUBLIC_.
# https://flespi.io → Tokens
FLESPI_TOKEN=your-flespi-token

# Shared secret to validate incoming Flespi webhook signatures (HMAC).
FLESPI_WEBHOOK_SECRET=your-webhook-secret

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
