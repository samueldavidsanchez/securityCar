# Base URL of the deployed Next.js API (the vivancar web app).
# Dev tips:
#   - Android emulator: http://10.0.2.2:3000
#   - iOS simulator:    http://localhost:3000
#   - Physical device:  http://<your-LAN-ip>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase — same project as the web app. Public values only.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Sign-In (opcional: si falta, el botón de Google no se muestra).
# Es el client ID de tipo *Web*, NO el de Android — con el de Android, Google
# responde DEVELOPER_ERROR. Android se identifica por el SHA-1 del keystore
# registrado en Google Cloud Console, no por un id en el código.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Solo para iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
